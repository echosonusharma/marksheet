{
  "manifest_version": 3,
  "name": "marksheet",
  "version": "1.0.0",
  "description": "bookmark to google-sheet",
  "permissions": ["identity", "tabs", "storage", "alarms", "sidePanel", "contextMenus"],
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "host_permissions": ["https://sheets.googleapis.com/*"],
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Marksheet - click to save",
    "default_icon": {
      "16": "assets/icon_16.png",
      "32": "assets/icon_32.png",
      "48": "assets/icon_48.png",
      "128": "assets/icon_128.png"
    }
  },
  "icons": {
    "16": "assets/icon_16.png",
    "32": "assets/icon_32.png",
    "48": "assets/icon_48.png",
    "128": "assets/icon_128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://sheets.googleapis.com https://oauth2.googleapis.com; object-src 'none'"
  },
  "key": ""
}
